#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "It is certain."
msgstr "Це очевидно."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "It is decidedly so."
msgstr "Це має бути так."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "Without a doubt."
msgstr "Без сумніву."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "Yes definitely."
msgstr "Так, безперечно."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "You may rely on it."
msgstr "Ви можете на це покластися."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "As I see it, yes."
msgstr "Як мені здається, так."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "Most likely."
msgstr "Найімовірніше."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "Outlook good."
msgstr "Перспективи добрі."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "Yes."
msgstr "Так."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "Signs point to yes."
msgstr "Усе вказує на «так»."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "Reply hazy, try again."
msgstr "Відповідь нечітка, спробуйте ще раз."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "Ask again later."
msgstr "Запитайте пізніше."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "Better not tell you now."
msgstr "Не варто вам зараз говорити."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "Cannot predict now."
msgstr "Зараз передбачити неможливо."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "Concentrate and ask again."
msgstr "Сконцентруйтеся і спробуйте відповісти знову."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "Don't count on it."
msgstr "Не розраховуйте на це."

#: src/whisp/editor_helpers/editor_expansions.py:286
msgid "My reply is no."
msgstr "Моя відповідь — «ні»."

